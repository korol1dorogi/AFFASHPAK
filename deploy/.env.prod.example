# Server .env (VPS only). Copy to the repo root on the server: cp deploy/.env.prod.example .env && chmod 600 .env
# Fill every value; generate secrets on the server (commands in docs/deploy.md). Never commit the result.

COMPOSE_FILE=docker-compose.prod.yml

# --- Public address ---
# Domain pointing to the VPS, or <ip-with-dashes>.sslip.io if there is no domain (e.g. 203-0-113-10.sslip.io)
DOMAIN=

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=${DOMAIN}
DJANGO_CSRF_TRUSTED_ORIGINS=https://${DOMAIN}
# Unguessable back-office path, must end with "/" (e.g. office-3f9c1a7e/)
DJANGO_ADMIN_URL=

# --- PostgreSQL ---
POSTGRES_DB=alfa
POSTGRES_USER=alfa
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- AI assistant ---
# Keep mock until organizers confirm case data may go to an external LLM (docs/decisions.md D8).
# Use a separate key for the stand with a hard monthly budget limit.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Case data: absolute path on the server, outside the repo; mounted read-only ---
CASE_DATA_DIR=/srv/alfa-case-data
