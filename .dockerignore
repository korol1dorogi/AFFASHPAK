# Build context is the repo root for backend and caddy images; send only what they need (allowlist).
*
!backend/
!docs/openapi.yaml
!frontend/
!deploy/

# Never in the image, even inside allowed folders
.env
.env.*
**/.env
**/.env.*
.git
**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
backend/staticfiles
backend/media
frontend/dist
