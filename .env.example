# Copy to .env: cp .env.example .env
# Only placeholders here. Real secrets live in your local .env and never get committed.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-placeholder-change-me-in-local-env-and-on-the-server
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, only needed behind a proxy on another origin (prod: https://your.domain)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/

# --- PostgreSQL ---
POSTGRES_DB=alfa
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Local web (docker compose: cabinet at http://localhost:${WEB_PORT}) ---
WEB_PORT=8080

# --- Demo stand ---
# 1 = demo personas for quick sign-in (seeded on start) and /api/demo/*; 0 = off
DEMO_MODE=1
# Applications in the demo bank queue (seed and «Сброс демо-данных»); unset — 30
# DEMO_QUEUE_SIZE=300

# --- Bank queue SLA ---
# Hours per status before an application is overdue in the bank queue (XP4). Empty = defaults:
# submitted=1, processing=1, manual_review=24, signed=1
SLA_HOURS=

# --- AI assistant ---
# mock = deterministic provider without network or key (default, used in tests)
# openai = any OpenAI-compatible API (LLM_BASE_URL, LLM_API_KEY, LLM_MODEL)
# LLM_MODEL may list open-weight models comma separated: a model at its rate limit hands over
# to the next at once, e.g. qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b (Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1). The key lives only in the server's .env.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# Seconds for a whole answer; budget + one request must stay under gunicorn's 120 (prod)
LLM_TURN_BUDGET_SECONDS=60
# Model ↔ tools round trips per answer
LLM_MAX_STEPS=4
# Guardrails: block (regenerate once, then a safe answer) or log (only log the trigger)
GUARDRAILS_MODE=block

# --- Case data ---
# Host path, mounted read-only into backend at /case-data.
# Real case data must live OUTSIDE the repo, e.g. ../alfa-case-data. Default: synthetic sample.
CASE_DATA_DIR=./data/sample
